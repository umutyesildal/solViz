venv/
env/
.venv/
__pycache__/
.pytest_cache/
.ruff_cache/
.mypy_cache/
bower_components/
jspm_packages/

# Build outputs
dist/
build/
*.egg-info/
.eggs/
wheels/
.next/
out/
storybook-static/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*

# Testing
coverage/
.coverage
.coverage.*
htmlcov/
.nyc_output/
junit*.xml
*.lcov
test-results/
cypress/videos/
cypress/screenshots/
